# ======================================================================
# Quantum Image Edge Detection (NEQR + QHED) - environment configuration
# Loaded via python-dotenv in src/qedge/config.py
# ======================================================================

# Global reproducibility seed
QEDGE_SEED=12345

# Default simulator shot budget (overridden by experiment sweeps)
QEDGE_SHOTS=4096

# Shot sweep (comma separated) used by the shot-requirement experiment
QEDGE_SHOT_SWEEP=256,512,1024,2048,4096,8192,16384,32768

# Image sizes to evaluate (width==height, power of two for NEQR/QHED)
QEDGE_IMAGE_SIZES=4,8,16,32

# Noise sweep: two-qubit depolarizing error probabilities (base scale)
QEDGE_NOISE_SWEEP=0.0,0.001,0.005,0.01,0.02

# Directories
QEDGE_DATA_DIR=data
QEDGE_RESULTS_DIR=results

# BSDS500 dataset (optional). If the archive is not present/downloadable the
# pipeline falls back to bundled synthetic + standard greyscale test images.
QEDGE_BSDS500_URL=https://www2.eecs.berkeley.edu/Research/Projects/CS/vision/grouping/BSR/BSR_bsds500.tgz
QEDGE_BSDS500_DIR=data/BSDS500
QEDGE_USE_BSDS500=1

# Max number of BSDS500 images to sample into the benchmark
QEDGE_BSDS500_SAMPLE=4
